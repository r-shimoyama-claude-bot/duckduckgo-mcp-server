# DuckDuckGo MCP Server configuration
# Copy this file to .env and fill in your values.

# --- Search settings ---
# SafeSearch: STRICT | MODERATE (default) | OFF
# DDG_SAFE_SEARCH=MODERATE

# Default region: us-en, jp-ja, uk-en, de-de, fr-fr, wt-wt, etc.
# DDG_REGION=

# Min seconds between requests (default: 2.0)
# DDG_THROTTLE=2.0

# Throttle jitter fraction (default: 0.3 = +-30%)
# DDG_THROTTLE_JITTER=0.3

# Rotate HTTP session every N requests (default: 10)
# DDG_SESSION_ROTATION_INTERVAL=10

# Warm up new primp sessions with a GET to fetch cookies before POST search (default: 1)
# DDG_WARMUP=1

# --- Tor daemon & Onion route (CAPTCHA-free, fast batch search) ---
# When DDG_BASE_URL is unset and DDG_AUTO_TOR=1 (default), the server probes
# 127.0.0.1:9050-9059 (or DDG_TOR_SOCKS_PORTS) at startup; if a Tor daemon is
# found it auto-selects the CAPTCHA-free Onion route.
# DDG_AUTO_TOR=1

# If no Tor daemon is found at startup, start one automatically (default: 1).
# Tries `service tor start` -> `systemctl start tor` -> a raw `tor` subprocess,
# then polls the SOCKS ports up to DDG_TOR_BOOTSTRAP_TIMEOUT seconds. Useful on
# non-systemd hosts (WSL2) where Tor isn't started at boot. Set 0 to disable.
# Ignored when DDG_AUTO_TOR=0 or DDG_BASE_URL is set explicitly.
# DDG_AUTO_TOR_START=1

# Override the Tor start command entirely (advanced/testing).
# DDG_TOR_START_COMMAND=sudo systemctl start tor

# Seconds to wait for Tor SOCKS ports to open after auto-start (default: 60).
# DDG_TOR_BOOTSTRAP_TIMEOUT=60

# --- Tor multi-port pool (Onion route, bandwidth aggregation) ---
# Comma-separated Tor SOCKS ports (must match SocksPort entries in torrc).
# Empty/unset → single DDG_PROXY.
# DDG_TOR_SOCKS_PORTS=127.0.0.1:9050,127.0.0.1:9051,127.0.0.1:9052,127.0.0.1:9053,127.0.0.1:9054
# DDG_TOR_THROTTLE_PER_PORT=0
# DDG_TOR_MAX_CONNECTIONS_PER_PORT=4

# --- Batch search ---
# DDG_BATCH_CONCURRENCY=8
# DDG_BATCH_MAX=100

# Retry base delay on 202/429 (default: 3.0)
# DDG_RETRY_DELAY=3.0

# Max retries on CAPTCHA/rate-limit (default: 3)
# DDG_MAX_RETRIES=3

# --- Proxy (single) ---
# SOCKS5 proxy for Tor, e.g. socks5h://127.0.0.1:9050
# DDG_PROXY=

# Override DDG Lite endpoint (e.g. Tor Onion address)
# DDG_BASE_URL=https://duckduckgogg42xjoc72x3sjasowoarfbgcmvfimaftt6twagswzczad.onion/lite/

# --- Proxy pool (residential, recommended) ---
# Comma-separated list: ip:port:user:pass
# DDG_PROXIES=1.2.3.4:8080:user:pass,5.6.7.8:9090:user2:pass2

# Target seconds between searches across all proxies (default: 5.0)
# Throttle per proxy = target / active_count (e.g. 3.0/10 = 0.3s)
# DDG_PROXIES_TARGET_INTERVAL=3.0

# Seconds to block a proxy after CAPTCHA/403 (default: 300.0)
# DDG_PROXIES_COOLDOWN=300.0

# --- Fetch content ---
# Per-domain throttle for fetch_content in seconds (default: 1.0)
# DDG_FETCH_THROTTLE=1.0
